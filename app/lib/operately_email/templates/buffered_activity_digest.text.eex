<%= if @total_updates == 1,
      do: t("bufferedActivityDigest.youHaveOneNewUpdate"),
      else: t("bufferedActivityDigest.youHaveNewUpdates", %{v1: @total_updates}) %>

<%= if Enum.empty?(@parent_groups) do %>
<%= t("bufferedActivityDigest.youReAllCaughtUp2") %>
<%= t("bufferedActivityDigest.noNewUpdates") %>
<% else %>
<%= for group <- @parent_groups do %>
<% group_total = Enum.reduce(group.author_groups, 0, fn ag, acc -> acc + length(ag.items) end) %>
<%= group.parent_name %> (<%= if group_total == 1, do: t("bufferedActivityDigest.oneUpdate"), else: t("bufferedActivityDigest.nUpdates", %{v1: group_total}) %>)
<%= if group.parent_url do %>
<%= group.parent_url %>
<% end %>
<%= for author_group <- group.author_groups do %>
<%= if length(author_group.items) == 1 do %>
<%= for item <- author_group.items do %>
  <%= item.actor_name %>: <%= item.headline %>
<%= if item.excerpt_text do %>
    <%= item.excerpt_text %>
<% end %>
    <%= item.item_url %>

<% end %>
<% else %>

<%= author_group.actor_name %>:
<%= for item <- author_group.items do %>
  <%= item.headline %>
<%= if item.excerpt_text do %>
    <%= item.excerpt_text %>
<% end %>
    <%= item.item_url %>

<% end %>
<% end %>
<% end %>
<% end %>
<% end %>

---
<%= t("bufferedActivityDigest.manageEmailSettings2", %{v1: @settings_url}) %>
