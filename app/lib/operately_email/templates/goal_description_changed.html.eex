<%= title(t("goalDescriptionChanged.v1UpdatedTheDescriptionForV2", %{v1: short_name(@author), v2: @goal_name})) %>

<%= spacer() %>

<%= if @description do %>
  <%= row do %>
    <%= rich_text(@description) %>
  <% end %>
<% else %>
  <%= row do %>
    <%= t("goalDescriptionChanged.theDescriptionWasCleared") %>
  <% end %>
<% end %>

<%= spacer() %>

<%= row do %>
  <%= cta_button(@cta_url, t("goalDescriptionChanged.viewGoal")) %>
<% end %>
