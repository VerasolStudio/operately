<%= title(t("goalReparent.v1ChangedTheGoalParentOf", %{v1: short_name(@author), v2: @goal.name})) %>

<%= spacer() %>

<%= if @new_parent_goal do %>
  <%= row do %>
    <%= t("goalReparent.theParentGoalOfWasChanged", %{v1: @goal.name, v2: @new_parent_goal.name}) %>
  <% end %>
<% else %>
  <%= row do %>
    <%= t("goalReparent.theParentGoalWasRemovedFrom", %{v1: @goal.name}) %>
  <% end %>
<% end %>

<%= spacer() %>

<%= row do %>
  <%= cta_button(@cta_url, t("goalReparent.viewGoal")) %>
<% end %>
