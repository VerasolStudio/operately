<%= title(t("goalTimeframeEditing.v1EditedTheTimeframeOfThe", %{v1: short_name(@author), v2: @goal.name})) %>

<%= spacer() %>

<%= row do %>
  <%= t("goalTimeframeEditing.oldTimeframe") %> <%= Date.to_string(@old_timeframe.start_date) %> &rarr; <%= Date.to_string(@old_timeframe.end_date) %>
<% end %>

<%= row do %>
  <%= t("goalTimeframeEditing.newTimeframe") %> <%= Date.to_string(@new_timeframe.start_date) %> &rarr; <%= Date.to_string(@new_timeframe.end_date) %>
<% end %>

<%= spacer() %>

<%= row do %>
  <%= rich_text(@message) %>
<% end %>

<%= spacer() %>

<%= row do %>
  <%= cta_button(@link, t("goalTimeframeEditing.viewComment")) %>
<% end %>
