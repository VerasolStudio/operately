<%= title("#{short_name(@author)} #{@action}") %>

<%= spacer() %>

<%= row do %>
  <%= if @mentioned do %>
    <%= t("taskAdding.youWereMentionedInTheDescription", %{v1: @task_name}) %>
  <% else %>
    <%= t("taskAdding.aNewTaskNamedWasCreated", %{v1: @task_name}) %>
  <% end %>
<% end %>

<%= spacer() %>

<%= row do %>
  <%= cta_button(@cta_url, t("taskAdding.viewTask")) %>
<% end %>
