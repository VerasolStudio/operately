<%= title("#{short_name(@author)} #{@action}") %>

<%= spacer() %>

<%= if @description do %>
  <%= row do %>
    <%= rich_text(@description) %>
  <% end %>
<% else %>
  <%= row do %>
    <%= t("taskDescriptionChange.theDescriptionWasCleared") %>
  <% end %>
<% end %>

<%= spacer() %>

<%= row do %>
  <%= cta_button(@cta_url, t("taskDescriptionChange.viewTask")) %>
<% end %>
